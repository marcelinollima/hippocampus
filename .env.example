# --- required -------------------------------------------------------------
# Public domain pointing at this server (used by Caddy for HTTPS).
DOMAIN=memory.example.com
# Access token. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
HIPPOCAMPUS_TOKEN=change-me

# --- optional -------------------------------------------------------------
# Your name, used in the instructions the MCP server gives to Claude.
HIPPOCAMPUS_OWNER=the user
# Language of the MCP instructions and of the text the server writes into
# Claude's context: en (default) or pt.
HIPPOCAMPUS_LANG=en
# Name of a memory injected on top of EVERY recall (e.g. a routing map).
# Only the part above <!-- END-PINNED --> is sent.
HIPPOCAMPUS_PINNED=
# Lets clients that cannot send headers (claude.ai custom connectors) use
# https://DOMAIN/mcp/<secret>. Leave empty to disable. Treat it like the token.
HIPPOCAMPUS_URL_SECRET=
# Replace the default MCP instructions with your own text or file.
HIPPOCAMPUS_INSTRUCTIONS_FILE=
# Embedding model (fastembed name). The default is multilingual, 384 dims, ~220 MB.
HIPPOCAMPUS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Extra Host headers accepted on /mcp (DNS-rebinding protection), comma separated.
HIPPOCAMPUS_ALLOWED_HOSTS=
