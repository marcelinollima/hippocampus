# Bare-metal alternative to Docker. Install:
#   sudo useradd --system --create-home --home-dir /opt/hippocampus hippocampus
#   sudo -u hippocampus python3 -m venv /opt/hippocampus/.venv
#   sudo -u hippocampus /opt/hippocampus/.venv/bin/pip install git+https://github.com/marcelinollima/hippocampus
#   sudo cp .env.example /opt/hippocampus/.env   # and edit it
#   sudo cp hippocampus.service /etc/systemd/system/ && sudo systemctl enable --now hippocampus
# Put Caddy (deploy/Caddyfile with UPSTREAM=127.0.0.1:8765) or another TLS proxy in front.
[Unit]
Description=Hippocampus long-term memory (MCP + web)
After=network-online.target
Wants=network-online.target

[Service]
User=hippocampus
WorkingDirectory=/opt/hippocampus
EnvironmentFile=/opt/hippocampus/.env
Environment=HIPPOCAMPUS_DATA_DIR=/opt/hippocampus/data
# 127.0.0.1 on purpose: only the TLS proxy talks to the internet. While a test
# install listened on 0.0.0.0, bots were scanning it for /.env within hours.
Environment=HIPPOCAMPUS_HOST=127.0.0.1
ExecStart=/opt/hippocampus/.venv/bin/hippocampus serve
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/hippocampus
PrivateTmp=true

[Install]
WantedBy=multi-user.target
